{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/web", "destination": "https://mon.davidwang.space/api/web" },
    { "source": "/agent-prompt.md", "destination": "/previews/crewtrace/agent-prompt.md" },
    { "source": "/agent-prompt.en.md", "destination": "/previews/crewtrace/agent-prompt.en.md" },
    { "source": "/skills/crewtrace/:path*", "destination": "/previews/crewtrace/skills/crewtrace/:path*" }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.davidwang.space" }],
      "destination": "https://davidwang.space/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Link", "value": "</llms.txt>; rel=\"describedby\"; type=\"text/plain\", </index.md>; rel=\"alternate\"; type=\"text/markdown\", </data/portfolio.json>; rel=\"alternate\"; type=\"application/json\"" }
      ]
    },
    {
      "source": "/:path*.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Link", "value": "</llms.txt>; rel=\"describedby\"; type=\"text/plain\"" }
      ]
    },
    {
      "source": "/data/portfolio.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Link", "value": "</llms.txt>; rel=\"describedby\"; type=\"text/plain\"" }
      ]
    }
  ]
}
